{
  "expo": {
    "name": "שיעור",
    "slug": "reporting-hours",
    "scheme": "reporting-hours",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.reportinghours.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B3C3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "האפליקציה משתמשת בזיהוי פנים כדי לפתוח את הנעילה."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "האפליקציה ניגשת לאנשי הקשר כדי לבחור מספר טלפון להזמנת מונית."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#305A58"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B3C3B"
        }
      ],
      "./plugins/withLeanAndroid",
      "./plugins/withThemedSplash"
    ],
    "extra": {
      "supportsRTL": true
    },
    "experiments": {
      "baseUrl": "/Reporting-hours"
    }
  }
}

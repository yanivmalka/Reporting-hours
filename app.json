{
  "expo": {
    "name": "דיווח שעות",
    "slug": "reporting-hours",
    "scheme": "reporting-hours",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.reportinghours.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Heebo",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Heebo_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Heebo_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Heebo_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Heebo_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Heebo_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "האפליקציה ניגשת לאנשי הקשר כדי לבחור מספר טלפון להזמנת מונית."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E7C7B"
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    },
    "experiments": {
      "baseUrl": "/Reporting-hours"
    }
  }
}
